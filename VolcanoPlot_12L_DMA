
#Loading Packages:

library(methylKit)
library(ggplot2)

#Loading DMA results table:

myDiff_12 <- readRDS("myDiff_min12_alive_dead.rds")
df12 <- getData(myDiff_12)


#Plotting the Volcano Plot 

p <- ggplot(
  df12,
  aes(
    x = df12[ , "meth.diff"],
    y = -log10(df12[ , "qvalue"]),
    colour = ifelse(df12[ , "meth.diff"] > 0,
                    "Hypermethylated", "Hypomethylated")
  )
)

p <- p + geom_point(alpha = 0.4, size = 0.5)

p <- p + geom_vline(xintercept = 0, colour = "red")

p <- p + scale_colour_manual(
  values = c(
    "Hypermethylated" = "red",
    "Hypomethylated"  = "blue"
  ),
  name = "Legend"
)

p <- p + labs(
  title = "Differential Methylation Analysis Volcano Plot (All CpGs)",
  x     = "Methylation Difference (%)",
  y     = expression(-log[10](q-value))
)

#Original code produced a transparent background (hard readability) so had to explicitely state I wanted a white background 

p <- p + theme_minimal(base_size = 14) +
  theme(
    legend.position   = "right",
    legend.background = element_rect(fill   = "white", colour = "black"),
    plot.background   = element_rect(fill = "white", colour = NA),
    panel.background  = element_rect(fill = "white", colour = NA),
)

ggsave("volcano_myDiff12_nice.png", plot  = p, width = 9, height = 7, dpi = 300, bg = "white")
