install.packages("glmnet")
install.packages("rsample")
install.packages("pROC")

library(glmnet)
library(rsample)
library(pROC)

# Loading the data

X_scaled <- readRDS("ML_X_top100_beta.rds")
y <- readRDS("ML_y_dead_alive.rds")

# Creating a data frame

sample_ids <- rownames(X_scaled)

data_for_split <- data.frame(id = sample_ids, y  = y)

# Perform the train/test split on samples

set.seed(42)

split_70_30 <- initial_split(data_for_split, prop = 0.7, strata = y)

train_data <- training(split_70_30)
test_data  <- testing(split_70_30)

train_idx <- match(train_data$id, sample_ids)
test_idx  <- match(test_data$id, sample_ids)

X_train <- X_scaled[train_idx, ]
y_train <- y[train_idx]
X_test  <- X_scaled[test_idx, ]
y_test  <- y[test_idx]

dim(X_train)
dim(X_test)

alphas <- c(0.25, 0.5, 0.8)

results_70_30 <- data.frame(
  alpha = numeric(),
  lambda_min = numeric(),
  train_auc = numeric(),
  test_auc = numeric()
)

for (a in alphas) {
  fit_elastic <- cv.glmnet(
    x = X_train,
    y = y_train,
    family = "binomial",
    alpha = a,
    type.measure = "deviance"
  )

  lambda_best <- fit_elastic$lambda.min

  pred_train <- as.numeric(predict(fit_elastic, s = lambda_best, newx = X_train, type = "response"))
  auc_train <- as.numeric(auc(roc(response = y_train, predictor = pred_train)))

  pred_test <- as.numeric(predict(fit_elastic, s = lambda_best, newx = X_test, type = "response"))
  auc_test <- as.numeric(auc(roc(response = y_test, predictor = pred_test)))

  results_70_30 <- rbind(results_70_30, data.frame(alpha = a, lambda_min = lambda_best, train_auc = auc_train,test_auc = auc_test))
}

results_70_30
